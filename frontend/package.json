{
  "name": "scenaria-frontend",
  "private": true,
  "version": "0.29.0-dev",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:journeys": "playwright test -c e2e/playwright.config.ts e2e/specs/user-journeys.spec.ts",
    "test:e2e:qa": "playwright test -c e2e/playwright.config.ts e2e/specs/qa-daily-use.spec.ts",
    "test:e2e:desktop": "playwright test -c e2e/playwright.desktop.config.ts",
    "test:e2e:install": "playwright install chromium",
    "docs:screenshots": "playwright test -c e2e/playwright.docs.config.ts",
    "docs:demo-video": "go test ../internal/report/... -run \"TestWriteReport.*Fixture\" -count=1 && playwright test -c e2e/playwright.demo.config.ts"
  },
  "dependencies": {
    "@monaco-editor/loader": "^1.4.0",
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@tsconfig/svelte": "^5.0.4",
    "jsdom": "^25.0.1",
    "svelte": "^4.2.19",
    "svelte-check": "^4.0.5",
    "svelte-preprocess": "^6.0.3",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
